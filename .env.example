# Copy to .env and fill in. Never commit .env.
DEEPSEEK_API_KEY=
# Optional
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Where generated projects are created (default: ./projects)
CDD_WORKSPACE=
# Port for the local UI (default: 4317)
PORT=4317
# Set to "mock" to run without an API key using canned todo-app answers
CDD_AI=
